# Demo data is available only when this value is exactly true.
# Keep false in every deployed environment.
DEMO_MODE=false

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local: http://localhost:3000
# Production: canonical production URL. Preview deployments automatically use VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional until Resend API access and a verified sender domain are available.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
