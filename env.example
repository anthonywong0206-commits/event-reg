# Supabase (browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL. Production should use the production domain.
# Vercel Preview deployments automatically use their own VERCEL_URL for QR links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend. For production, use a sender on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Event Registration <events@example.com>

# Telegram notifications and scheduled delivery
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
